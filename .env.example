# =============================================================
# .env.example — Painel 1 · painel.centralplayplus.com.br
# Nunca versionar .env ou .env.local com credenciais reais.
# Copie este arquivo para .env.local e preencha os valores.
# =============================================================

# ── Aplicação ─────────────────────────────────────────────────
APP_URL=
NEXT_PUBLIC_APP_URL=
NODE_ENV=development

# ── Banco de dados ─────────────────────────────────────────────
DATABASE_URL=

# ── Supabase ───────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Painel 2 (mensagens, WhatsApp, Evolution, fluxos) ──────────
# O Painel 2 é um projeto separado. O Painel 1 só abre links.
NEXT_PUBLIC_REALTIME_PANEL_URL=https://painel2.centralplayplus.com.br

# ── XCloud ─────────────────────────────────────────────────────
XCLOUD_PANEL_URL=
XCLOUD_DEVICES_URL=
XCLOUD_CUSTOM_PLAYLIST_URL=
XCLOUD_EMAIL=
XCLOUD_PASSWORD=

# ── Painéis geradores ─────────────────────────────────────────

# Yellow Box
YELLOW_BOX_API_URL=
YELLOW_BOX_API_KEY=

# Ninety
NINETY_API_URL=
NINETY_API_KEY=
NINETY_PANEL_URL=
NINETY_PANEL_EMAIL=
NINETY_PANEL_PASSWORD=

# CineMax
CINEMAX_API_URL=
CINEMAX_API_KEY=

# Uniplay
UNIPLAY_API_URL=
UNIPLAY_API_KEY=

# DevXTop
DEVXTOP_API_URL=
DEVXTOP_API_KEY=

# BrasilTV
BRASILTV_API_URL=
BRASILTV_API_KEY=

# ── Segurança e logs ───────────────────────────────────────────
LOG_LEVEL=info
MASK_SENSITIVE_LOGS=true

# ── Operação ───────────────────────────────────────────────────
WHATSAPP_DEFAULT_COUNTRY_CODE=55

# ── Workers futuros ────────────────────────────────────────────
XCLOUD_WORKER_ENABLED=false
XCLOUD_WORKER_MODE=mock
XCLOUD_WORKER_MAX_RETRIES=2
XCLOUD_WORKER_SCREENSHOTS_DIR=storage/screenshots
